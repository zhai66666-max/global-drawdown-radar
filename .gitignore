# ── 本地环境与凭据 ──────────────────────────────────────────────────────────
.env
.env.local
*.env

# ── 每次运行都会变的产物 ────────────────────────────────────────────────────
# preview*.html 覆盖 preview.html 与带日期/来源后缀的留存副本（如 preview_云端实跑_*.html）
preview*.html
data/archive/

# 注意：以下两个文件需要**提交进仓库**，属于跨天累积的状态而非产物：
#   data/market.duckdb     行情库（DuckDB）
#   data/radar_state.json  雷达告警冷却状态，不提交的话"新信号"每天都会重复报警
# 所以它们不出现在上面的忽略清单里。

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 系统 ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
