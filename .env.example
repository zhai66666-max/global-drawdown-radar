# ═════════════════════════════════════════════════════════════════════════════
# 环境变量示例  →  复制成 .env 后填写；GitHub Actions 里配到 Secrets
#
# 【重要】两套命名都行，不用改你现有的 Secrets：
#   方案 A = 原 nasdaq-etf-monitor 的命名（EMAIL_*）
#   方案 B = 原 global-drawdown-radar / nasdaq100-daily-report 的命名（SENDER_*/SMTP_*/RECIPIENT_*）
# 两套同时存在时以方案 A 为准。填任意一套即可，另一套留空。
# ═════════════════════════════════════════════════════════════════════════════


# ── 方案 A：原 nasdaq-etf-monitor ────────────────────────────────────────────
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USERNAME=your_qq@qq.com
EMAIL_PASSWORD=your_qq_authorization_code
EMAIL_TO=your_qq@qq.com


# ── 方案 B：原 global-drawdown-radar / nasdaq100-daily-report ────────────────
# 注意：465 → 隐式 SSL；587 → STARTTLS。代码按端口自动判别，不用额外开关。
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SENDER_EMAIL=your@gmail.com
# SENDER_PASSWORD=your_gmail_app_password
# RECIPIENT_EMAIL=your@qq.com


# ── 收件人黑名单 ─────────────────────────────────────────────────────────────
# 逗号分隔。沿用原 etf-monitor 的机制，防止误发给测试地址。
# 默认值就是 1741534484@qq.com（原项目内置的挡板），要放开就显式改这里。
EMAIL_BLOCKLIST=1741534484@qq.com


# ── 测试模式 ─────────────────────────────────────────────────────────────────
# 填了之后【只发这一个地址】，正式收件人全部被覆盖，适合首次联调。
# TEST_RECIPIENT=


# ── AI 解读（DeepSeek）──────────────────────────────────────────────────────
# 不填也能跑：邮件照常发，只是没有第 12 节 AI 深度分析。
DEEPSEEK_API_KEY=


# ── 可选：数据源调优 ─────────────────────────────────────────────────────────
# ETF 数据抓取的并发数与超时（秒），网络差的时候调大
# BRIEF_HTTP_TIMEOUT=15
# BRIEF_MAX_WORKERS=6
